# Skillsmith auto-loads .env from the invocation directory using Node's
# process.loadEnvFile (no dotenv required). Shell environment variables
# take precedence over values set here.
#
# The default config uses only claude-code-provider agents. A logged-in
# Claude Code install needs no API keys at all. The keys below are only
# required when switching to an API-driven provider.

# For the anthropic-api provider. Also used as fallback auth for
# claude-code agents when no Claude Code login exists.
ANTHROPIC_API_KEY=sk-ant-...

# For the openai-api and codex providers.
OPENAI_API_KEY=sk-...

# For the gemini-api provider.
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
